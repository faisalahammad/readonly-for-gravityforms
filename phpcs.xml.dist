<?xml version="1.0"?>
<ruleset name="Readonly for Gravity Forms">
    <description>WordPress coding standards for Read Only Fields for Gravity Forms.</description>

    <file>./</file>

    <exclude-pattern>./vendor/</exclude-pattern>
    <exclude-pattern>./node_modules/</exclude-pattern>
    <exclude-pattern>./build-zip.php</exclude-pattern>

    <arg name="extensions" value="php" />
    <arg value="s" />

    <rule ref="WordPress-Extra">
        <exclude name="Generic.Arrays.DisallowShortArraySyntax.Found" />
        <exclude name="Universal.Arrays.DisallowShortArraySyntax.Found" />
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="readonly-for-gravityforms" />
            </property>
        </properties>
    </rule>

    <rule ref="WordPress-Extra">
        <exclude name="WordPress.Files.FileName.InvalidClassFileName" />
    </rule>

    <config name="testVersion" value="7.4-" />
    <rule ref="PHPCompatibilityWP" />
</ruleset>
