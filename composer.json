{
    "name": "faisalahammad/readonly-for-gravityforms",
    "description": "Adds a universal 'Read Only' option to all Gravity Forms fields.",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-or-later",
    "keywords": ["wordpress", "gravity-forms", "readonly"],
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "wp-coding-standards/wpcs": "^3.4",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^4.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "test": "phpunit",
        "build": [
            "@phpcs",
            "@test",
            "@zip"
        ],
        "zip": "@php build-zip.php"
    }
}
